{
  "name": "onplay-core",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema POS/ERP OnPlay — fuente de verdad de productos, precios, ventas y caja",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @onplay/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed -w @onplay/api",
    "crear-admin": "npm run crear-admin -w @onplay/api"
  },
  "engines": {
    "node": ">=20"
  }
}
